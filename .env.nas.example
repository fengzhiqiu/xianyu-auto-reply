# Copy this file to .env. Never commit .env (it contains credentials).

# GHCR image owner. GitHub names are lowercase in GHCR.
GHCR_OWNER=fengzhiqiu
# Prefer a released version, e.g. v1.0.0 or sha-<commit>; latest is for testing only.
IMAGE_TAG=latest

# Existing MySQL instance. Do NOT use localhost/127.0.0.1 from a container.
# If MySQL is published on this NAS host, host.docker.internal works with this Compose file.
# Otherwise set this to the NAS LAN IP or a Docker container hostname on a shared external network.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=xianyu_data
MYSQL_USER=xianyu
MYSQL_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD

# Existing Redis instance.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
REDIS_DB=0

# Only the frontend is published to the LAN.
FRONTEND_PORT=9000
FRONTEND_PUBLIC_URL=http://NAS_LAN_IP:9000
BACKEND_WEB_PUBLIC_URL=http://NAS_LAN_IP:9000

TZ=Asia/Shanghai
LOG_LEVEL=INFO
SQL_ECHO=false
CORS_ORIGINS=*
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
TOKEN_CACHE_TTL_MIN_HOURS=5
TOKEN_CACHE_TTL_MAX_HOURS=10

# Conservative first-run settings. Enable features deliberately after basic validation.
AUTO_START_CRAWL_JOBS=false
AUTO_START_WEBSOCKET=true
MAX_CAPTCHA_CONCURRENT=1
BROWSER_HEADLESS=true
CAPTCHA_DRISSIONPAGE_FALLBACK_ENABLED=false
CAPTCHA_DRISSIONPAGE_TIMEOUT=25
CAPTCHA_DRISSIONPAGE_HEADLESS=true
REDELIVERY_INTERVAL=5
RATE_INTERVAL=20

# Disable remote upstream content by default.
ENABLE_REMOTE_ADS=false
ENABLE_REMOTE_ANNOUNCEMENTS=false
ENABLE_REMOTE_POPUP_ANNOUNCEMENTS=false
